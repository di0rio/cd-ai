{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Caua AI",
  "version": "0.1.0",
  "identifier": "dev.caua.ai",
  "build": {
    "frontendDist": "../apps/desktop/out",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run --cwd apps/desktop dev",
    "beforeBuildCommand": "bun run --cwd apps/desktop build"
  },
  "app": {
    "windows": [
      {
        "title": "Cauã AI",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
